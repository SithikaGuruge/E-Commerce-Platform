VITE_ORDER_API_URL=http://localhost:4000
VITE_SHOP_API_URL=http://localhost:4001
VITE_PRODUCT_API_URL=http://localhost:4002
VITE_USER_API_URL=http://localhost:4003

# ===== PRODUCTION DEPLOYMENT OPTIONS =====

# Option 1: Direct EC2 Access (Docker Compose with exposed ports)
# If you access services directly via EC2 public IP
# Replace 'your-ec2-public-ip' with your actual EC2 instance IP
# VITE_ORDER_API_URL=http://your-ec2-public-ip:4000
# VITE_SHOP_API_URL=http://your-ec2-public-ip:4001
# VITE_PRODUCT_API_URL=http://your-ec2-public-ip:4002
# VITE_USER_API_URL=http://your-ec2-public-ip:4003

# Option 2: Nginx API Gateway (Recommended - already in your docker-compose.yml)
# All services behind a single domain/IP with path-based routing
# VITE_ORDER_API_URL=http://your-ec2-public-ip/order
# VITE_SHOP_API_URL=http://your-ec2-public-ip/shop
# VITE_PRODUCT_API_URL=http://your-ec2-public-ip/product
# VITE_USER_API_URL=http://your-ec2-public-ip/user

# Option 3: With Custom Domain + SSL (Best practice)
# VITE_ORDER_API_URL=https://api.yourdomain.com/order
# VITE_SHOP_API_URL=https://api.yourdomain.com/shop
# VITE_PRODUCT_API_URL=https://api.yourdomain.com/product
# VITE_USER_API_URL=https://api.yourdomain.com/user
